<Project>

  <!-- Points Dzaba.Build's resolve task at this package's ICacheStorage implementation - see
       ADR-0004. Probe for the newest built TFM so this works regardless of which of
       net8.0/net9.0/net10.0 was actually built. No UsingTask/Task of its own: Dzaba.Build's own
       resolve task loads this assembly itself, by path, into its own AssemblyLoadContext, so its
       ICacheStorage cast is type-safe - a separately-declared MSBuild task here would load into
       its own isolated load context instead and couldn't publish a type-compatible instance. -->
  <PropertyGroup>
    <_DzabaGhcrOciCacheTfm Condition="Exists('$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net10.0\Dzaba.Build.GhcrOciCache.dll')">net10.0</_DzabaGhcrOciCacheTfm>
    <_DzabaGhcrOciCacheTfm Condition="'$(_DzabaGhcrOciCacheTfm)' == '' and Exists('$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net9.0\Dzaba.Build.GhcrOciCache.dll')">net9.0</_DzabaGhcrOciCacheTfm>
    <_DzabaGhcrOciCacheTfm Condition="'$(_DzabaGhcrOciCacheTfm)' == '' and Exists('$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net8.0\Dzaba.Build.GhcrOciCache.dll')">net8.0</_DzabaGhcrOciCacheTfm>
    <_DzabaGhcrOciCacheTfm Condition="'$(_DzabaGhcrOciCacheTfm)' == ''">net10.0</_DzabaGhcrOciCacheTfm>

    <DzabaCacheStorageAssembly Condition="'$(DzabaCacheStorageAssembly)' == ''">$(MSBuildThisFileDirectory)..\bin\$(Configuration)\$(_DzabaGhcrOciCacheTfm)\Dzaba.Build.GhcrOciCache.dll</DzabaCacheStorageAssembly>
    <DzabaCacheStorageType Condition="'$(DzabaCacheStorageType)' == ''">Dzaba.Build.GhcrOciCache.GhcrOciCacheStorage</DzabaCacheStorageType>
  </PropertyGroup>

</Project>
